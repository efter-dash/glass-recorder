{
  "name": "glass-recorder",
  "version": "0.2.0",
  "private": true,
  "description": "Private, local camera recording for Windows and macOS",
  "author": "efter-dash",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "node scripts/prepare-vision.cjs && tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.32",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "com.efterdash.glassrecorder",
    "productName": "Glass Recorder",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "artifactName": "Glass-Recorder-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "extendInfo": {
        "NSCameraUsageDescription": "Glass Recorder uses your camera to record video locally.",
        "NSMicrophoneUsageDescription": "Glass Recorder uses your microphone to record audio locally."
      },
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": null
  }
}
